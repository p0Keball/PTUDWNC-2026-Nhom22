{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=foodblog;Username=foodblog;Password=foodblog123"
  },
  "Cors": {
    "Origins": ["http://localhost:3000"]
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin123",
    "Bucket": "culinary-blog",
    "PublicUrl": "http://localhost:9000",
    "UseSsl": false
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "FoodBlog"
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "http://localhost:3000/auth/google/callback"
    }
  },
  "Jwt": {
    "Issuer": "FoodBlog.API",
    "Audience": "FoodBlog.Client",
    "Secret": "dev-only-foodblog-jwt-secret-change-me-2026",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Redis": {
    "Connection": "localhost:6379"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "OrphanCleanup": {
    "Enabled": true,
    "IntervalHours": 24,
    "MinAgeHours": 24,
    "Prefix": "recipes/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({CorrelationId}) ({UserId}) {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/foodblog-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:o} [{Level:u3}] ({CorrelationId}) ({UserId}) {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*"
}
